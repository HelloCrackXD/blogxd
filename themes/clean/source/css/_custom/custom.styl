/* ---- Code block: Atom One Dark style (override highlight.styl) ---- */

figure.highlight {
  background: #282c34;
  border: 1px solid #3e4451;
  border-radius: 8px;
  padding: 14px 16px;
  text-shadow: none;
  box-shadow: 0 2px 8px rgba(0, 0, 0, .18);
  font-size: 14px;
  line-height: 1.7;
}

figure.highlight pre {
  color: #abb2bf;
  font-size: 14px;
  text-shadow: none;
}

figure.highlight code {
  background: transparent;
  color: #abb2bf;
  padding: 0;
  border-radius: 0;
}

figure.highlight table .gutter {
  border-right: 1px solid #3e4451;
  padding-right: 12px;
  color: #5c6370;
}

figure.highlight table .gutter .line {
  color: #5c6370;
}

figure.highlight table .code {
  color: #abb2bf;
  padding-left: 14px;
}

figure.highlight table .line {
  height: 22px;
}

figure.highlight table .line.marked {
  background: rgba(255, 255, 255, .12);
}

figure.highlight figcaption {
  color: #abb2bf;
  font-size: 13px;
  text-shadow: none;
}

/* Inline code */
code {
  color: #c7254e;
  background-color: rgba(0, 0, 0, .05);
  padding: 2px 4px;
  border-radius: 4px;
  font-size: 85%;
}


